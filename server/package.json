{
  "name": "gesfinancelites-server",
  "version": "1.0.0",
  "description": "API Express + MySQL pour CSE Divo — Gestion Financière Scolaire",
  "type": "module",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate_v2": "node src/db/migrate_v2.js",
    "seed": "node src/db/seed.js",
    "setup": "npm run migrate && npm run seed",
    "upgrade": "npm run migrate_v2"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.11.0",
    "node-cron": "^4.6.0",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  }
}
